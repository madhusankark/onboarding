# ============================================================
# Service Provider Onboarding Portal - Backend Environment
# Copy this file to `.env` and fill in your values.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/onboarding_portal
# Docker: mongodb://mongo:27017/onboarding_portal
MONGO_URI=mongodb://127.0.0.1:27017/onboarding_portal

# JWT secret (use a long random string in production)
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Default admin account created by the seeder
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@onboard.com
ADMIN_PASSWORD=Admin@123
ADMIN_PASSWORD_USED_IN_SEED=true

# Optional: Demo provider account
DEMO_PROVIDER_NAME=Demo Provider
DEMO_PROVIDER_EMAIL=provider@onboard.com
DEMO_PROVIDER_PASSWORD=Provider@123

# ============================================================
# Email notifications (Nodemailer)
# When SMTP details are missing, emails are logged to console
# in development mode instead of being sent.
# ============================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Service Provider Onboarding <no-reply@onboard.com>"